{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "CinemaAuthService",
    "Audience": "CinemaClients",
    "SecretKey": ""
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/register", "Methods": [ "POST" ] }
      },
      "auth-login": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/login", "Methods": [ "POST" ] }
      },
      "auth-refresh": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/refresh", "Methods": [ "POST" ] }
      },
      "auth-users": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { "Path": "/api/v1/auth/users", "Methods": [ "GET" ] }
      },
      "auth-protected": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },

      "movies-read": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/movies/{**catch-all}", "Methods": [ "GET" ] }
      },
      "movies-write": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { "Path": "/api/v1/movies/{**catch-all}", "Methods": [ "POST", "PUT", "PATCH", "DELETE" ] }
      },

      "showtimes-date-range": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "StaffOrAdmin",
        "Match": { "Path": "/api/showtimes/date-range", "Methods": [ "GET" ] }
      },
      "showtimes-read": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/showtimes/{**catch-all}", "Methods": [ "GET" ] }
      },
      "showtimes-write": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "StaffOrAdmin",
        "Match": { "Path": "/api/showtimes/{**catch-all}", "Methods": [ "POST", "PUT", "PATCH", "DELETE" ] }
      },

      "rooms-read": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "StaffOrAdmin",
        "Match": { "Path": "/api/rooms/{**catch-all}", "Methods": [ "GET" ] }
      },
      "rooms-write": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { "Path": "/api/rooms/{**catch-all}", "Methods": [ "POST", "PUT", "PATCH", "DELETE" ] }
      },

      "seats-by-room": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/seats/room/{roomId}", "Methods": [ "GET" ] }
      },
      "seats-manage": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "StaffOrAdmin",
        "Match": { "Path": "/api/seats/{**catch-all}", "Methods": [ "GET", "POST", "PUT", "PATCH" ] }
      },
      "seats-delete": {
        "ClusterId": "movie-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { "Path": "/api/seats/{**catch-all}", "Methods": [ "DELETE" ] }
      },

      "bookings": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/bookings/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "auth-service": { "Address": "http://localhost:5100/" }
        }
      },
      "movie-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "movie-service": { "Address": "http://localhost:5168/" }
        }
      },
      "booking-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "booking-service": { "Address": "http://localhost:5063/" }
        }
      }
    }
  }
}
