{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "CinemaAuthService",
    "Audience": "CinemaClients",
    "SecretKey": ""
  },

  "ShowtimeService": {
    "BaseUrl": "http://localhost:5168/"
  },

  "BookingExpiry": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "BatchSize": 100
  },

  "RefundPolicy": {
    "CustomerCancelBeforeHours": 2
  },

  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "cinema",
    "Password": "cinema",
    "Exchange": "cinema.events",
    "ClientName": "booking-service"
  },

  "PayOS": {
    "BaseUrl": "https://api-merchant.payos.vn/",
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": ""
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Mobile Cinema",
    "TimeoutSeconds": 10
  },

  "ConnectionStrings": {
    "BookingDb": "Host=localhost;Port=5432;Database=cinema_booking_db;Username=postgres;Password=2005",
    "NotificationDb": "Host=localhost;Port=5432;Database=cinema_notification_db;Username=postgres;Password=2005",
    "PaymentDb": "Host=localhost;Port=5432;Database=cinema_payment_db;Username=postgres;Password=2005"
  }
}
