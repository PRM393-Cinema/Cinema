        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Lỗi theo mã trạng thái",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, http_response_status_code) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{job}} {{http_response_status_code}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "4xx: lỗi phía người gọi (sai dữ liệu, thiếu quyền, ghế đã có người). 5xx: lỗi hệ thống / service phía sau không khả dụng."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Gọi sang service khác / PayOS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, server_address, result) (label_replace(label_replace(rate(http_client_request_duration_seconds_count{server_address!=\"jaeger\"}[5m]), \"result\", \"$1\", \"http_response_status_code\", \"(.+)\"), \"result\", \"$1\", \"error_type\", \"([a-z_]+)\"))",
          "legendFormat": "{{job}} → {{server_address}} {{result}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Gateway gọi các service; BookingService gọi MovieService và PayOS. connection_error / timeout: không kết nối được hoặc quá thời gian chờ."
    },
    {
      "id": 11,
      "type": "row",
      "title": "Nghiệp vụ (trong khoảng thời gian đang xem)",
