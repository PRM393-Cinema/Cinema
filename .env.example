# Copy file này thành .env (cùng thư mục Cinema_BE) rồi điền giá trị. File .env KHÔNG được commit.

# Mật khẩu user postgres cho container PostgreSQL (tự đặt, không liên quan PostgreSQL cài trên máy)
POSTGRES_PASSWORD=

# JWT key dùng chung cho AuthService, BookingService, ApiGateway (>= 32 ký tự, xem docs/DOCKER.md để tạo)
JWT_SECRET_KEY=

# Thư mục chứa file SQL của repo Project-Cinema-DB (mặc định nằm cạnh thư mục Cinema_BE)
# DB_SCRIPTS_DIR=../Project-Cinema-DB

# Tuỳ chọn: PayOS (để trống thì checkout PayOS báo 502)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Tuỳ chọn: SMTP, ví dụ Gmail + App Password (để trống thì không gửi email)
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
